{
  "name": "incident-investigator-vscode",
  "displayName": "Incident Investigator",
  "description": "Thread dump and log analysis for incident investigation",
  "version": "0.1.0",
  "publisher": "patlego",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pat-lego/vscode-case-plugin.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "icons/icon128.png",
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "incident-investigator",
          "title": "Incident Investigator",
          "icon": "icons/icon128.png"
        }
      ]
    },
    "views": {
      "incident-investigator": [
        {
          "id": "investigator.openCases",
          "name": "Open Cases",
          "type": "tree"
        },
        {
          "id": "investigator.closedCases",
          "name": "Closed Cases",
          "type": "tree"
        },
        {
          "id": "investigator.signatures",
          "name": "Signatures",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "investigator.newCase",
        "title": "New Investigation",
        "icon": "$(add)"
      },
      {
        "command": "investigator.openCase",
        "title": "Open Investigation"
      },
      {
        "command": "investigator.deleteCase",
        "title": "Delete Case"
      },
      {
        "command": "investigator.openCaseInFinder",
        "title": "Open in Finder"
      },
      {
        "command": "investigator.reloadSignatures",
        "title": "Reload Signatures",
        "icon": "$(refresh)"
      },
      { "command": "investigator.reopenCase", "title": "Reopen Case" },
      { "command": "investigator.sendToAI", "title": "Send Case to AI", "icon": "$(robot)" },
      { "command": "investigator.runStaticAnalysis", "title": "Run Static Analysis", "icon": "$(beaker)" },
      { "command": "investigator.filterOpenCases", "title": "Filter Open Cases", "icon": "$(search)" },
      { "command": "investigator.filterClosedCases", "title": "Filter Closed Cases", "icon": "$(search)" },
      { "command": "investigator.viewSignature", "title": "View Signature" },
      { "command": "investigator.editSignature", "title": "Edit Signature", "icon": "$(edit)" },
      { "command": "investigator.newSignature", "title": "New Signature", "icon": "$(add)" },
      { "command": "investigator.addToCase", "title": "Add to Case", "icon": "$(add)" },
      { "command": "investigator.reviewEvidenceWithAI", "title": "Send Evidence to AI", "icon": "$(robot)" },
      { "command": "investigator.queryThreadDumps", "title": "Query Thread Dumps", "icon": "$(search)" },
      { "command": "investigator.analyzeCdnCacheMisses", "title": "Analyze CDN Cache Misses", "icon": "$(cloud-download)" }
    ],
    "menus": {
      "view/title": [
        {
          "command": "investigator.newCase",
          "when": "view == investigator.openCases",
          "group": "navigation"
        },
        {
          "command": "investigator.filterOpenCases",
          "when": "view == investigator.openCases",
          "group": "navigation"
        },
        {
          "command": "investigator.runStaticAnalysis",
          "when": "view == investigator.openCases",
          "group": "navigation"
        },
        {
          "command": "investigator.analyzeCdnCacheMisses",
          "when": "view == investigator.openCases",
          "group": "navigation"
        },
        {
          "command": "investigator.filterClosedCases",
          "when": "view == investigator.closedCases",
          "group": "navigation"
        },
        {
          "command": "investigator.reloadSignatures",
          "when": "view == investigator.signatures",
          "group": "navigation"
        },
        {
          "command": "investigator.newSignature",
          "when": "view == investigator.signatures",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "investigator.addToCase",
          "when": "resourceScheme == 'file'",
          "group": "7_modification@99"
        }
      ],
      "view/item/context": [
        {
          "command": "investigator.openCaseInFinder",
          "when": "(view == investigator.openCases || view == investigator.closedCases) && viewItem == case",
          "group": "navigation@1"
        },
        {
          "command": "investigator.deleteCase",
          "when": "(view == investigator.openCases || view == investigator.closedCases) && viewItem == case",
          "group": "9_cutcopypaste@1"
        },
        {
          "command": "investigator.sendToAI",
          "when": "(view == investigator.openCases || view == investigator.closedCases) && viewItem == case",
          "group": "navigation@2"
        },
        {
          "command": "investigator.viewSignature",
          "when": "view == investigator.signatures && viewItem == signature",
          "group": "navigation@1"
        },
        {
          "command": "investigator.editSignature",
          "when": "view == investigator.signatures && viewItem == signature",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Incident Investigator",
      "properties": {
        "investigator.engineerInitials": {
          "type": "string",
          "description": "Your initials, used in case IDs (e.g. PL)"
        },
        "investigator.signaturesPath": {
          "type": "string",
          "description": "Path to signature library YAML files"
        },
        "investigator.bridgePort": {
          "type": "number",
          "default": 7734,
          "description": "WebSocket port for browser extension bridge"
        },
        "investigator.casePaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Folders to scan for cases. Each folder may contain multiple case subfolders where the subfolder name matches its primary MD file (e.g. issues/ISSUE-1/ISSUE-1.md). All paths are scanned on startup. New cases are written to the first path in the list."
        },
        "investigator.notesTemplatePath": {
          "type": "string",
          "description": "Path to a Markdown file used as the template for new case notes. Supports placeholders: {{caseId}}, {{title}}, {{date}}, {{initials}}."
        },
        "investigator.cdn.splunkIndex": {
          "type": "string",
          "default": "dx_aem_edge_prod",
          "description": "Splunk index that holds the CDN access logs (used by Analyze CDN Cache Misses)."
        },
        "investigator.cdn.splunkSourcetype": {
          "type": "string",
          "default": "",
          "description": "Optional: Splunk sourcetype for the CDN logs. Leave empty if the index alone scopes to CDN logs (dx_aem_edge_prod needs no sourcetype). Set it only if your index mixes sourcetypes."
        },
        "investigator.cdn.defaultTier": {
          "type": "string",
          "enum": ["publish", "author"],
          "default": "publish",
          "description": "Default AEM tier (aem_tier) to analyze. Can be changed per run in the panel."
        },
        "investigator.cdn.skyPath": {
          "type": "string",
          "default": "sky",
          "description": "Path to the `sky` CLI used to run Splunk queries. Defaults to resolving 'sky' on PATH."
        },
        "investigator.cdn.fetchBaseline": {
          "type": "boolean",
          "default": true,
          "description": "Run a second, cheap Splunk query for normal POP usage (to identify rarely-used/cold POPs). CDN queries are slow, so this doubles query count."
        },
        "investigator.cdn.baselineDays": {
          "type": "number",
          "default": 2,
          "maximum": 2,
          "description": "How many days before the incident window to sample for the POP-usage baseline. Capped at 2 (CDN queries are expensive)."
        },
        "investigator.cdn.maxEvents": {
          "type": "number",
          "default": 100000,
          "description": "Row cap applied to the incident query (| head N). Raise for very busy services; results are truncated (and flagged) when exceeded."
        },
        "investigator.cdn.timeoutSeconds": {
          "type": "number",
          "default": 300,
          "description": "Timeout for each `sky splunk query` invocation, in seconds."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "build:tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/validate-webviews.js && npx @vscode/vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@incident-investigator/core": "*",
    "js-yaml": "^4.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0",
    "vitest": "^1.6.1"
  }
}
